# ---------------------------------------------------------------------------
# Sagara Denim — environment produksi
# Salin ke deploy/.env.production, isi nilai asli, lalu chmod 600.
# File ini TIDAK boleh masuk repositori.
# ---------------------------------------------------------------------------

# Domain dan TLS
SAGARA_DOMAIN=sagara.example.com
ACME_EMAIL=admin@example.com
PUBLIC_ORIGIN=https://sagara.example.com

# Image immutable dari GHCR. Gunakan tag rilis atau digest sha256.
SAGARA_BACKEND_IMAGE=ghcr.io/denislistiadi/sagara-denim/backend:v0.0.0
SAGARA_FRONTEND_IMAGE=ghcr.io/denislistiadi/sagara-denim/frontend:v0.0.0

# Secret aplikasi (minimal 32 karakter, acak)
JWT_SECRET=GANTI_DENGAN_OPENSSL_RAND_BASE64_48
METRICS_TOKEN=GANTI_DENGAN_OPENSSL_RAND_HEX_32

# Database
POSTGRES_DB=sagara_denim
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=GANTI_PASSWORD_BOOTSTRAP
POSTGRES_OWNER_USER=sagara_owner
POSTGRES_OWNER_PASSWORD=GANTI_PASSWORD_OWNER
POSTGRES_APP_USER=sagara_app
POSTGRES_APP_PASSWORD=GANTI_PASSWORD_APP
POSTGRES_BACKUP_USER=sagara_backup
POSTGRES_BACKUP_PASSWORD=GANTI_PASSWORD_BACKUP

# Backup lokal di VPS. Path absolut, bukan relatif terhadap repositori.
BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=28
BACKUP_HOST_DIR=/opt/sagara-backups
BACKUP_METRICS_HOST_DIR=/opt/sagara-backups/metrics

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GANTI_PASSWORD_GRAFANA

# Port edge (ubah hanya bila 80/443 sudah dipakai)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
