# ---------------------------------------------------------------------------
# Sagara Denim — staging lokal
# Salin ke deploy/.env.local. Nilai di bawah hanya untuk pengembangan.
# ---------------------------------------------------------------------------

SAGARA_DOMAIN=sagara.localhost
ACME_EMAIL=admin@sagara.localhost
PUBLIC_ORIGIN=https://sagara.localhost:8443

# Nilai ini diganti oleh overlay build lokal, tetapi tetap harus terisi agar
# interpolasi Compose pada file dasar berhasil.
SAGARA_BACKEND_IMAGE=sagara-denim-backend:local
SAGARA_FRONTEND_IMAGE=sagara-denim-frontend:local

CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

JWT_SECRET=local-staging-jwt-secret-minimal-32-karakter
METRICS_TOKEN=local-staging-metrics-token-minimal-32-karakter

POSTGRES_DB=sagara_denim_staging
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=local-bootstrap-password
POSTGRES_OWNER_USER=sagara_owner
POSTGRES_OWNER_PASSWORD=local-owner-password
POSTGRES_APP_USER=sagara_app
POSTGRES_APP_PASSWORD=local-app-password
POSTGRES_BACKUP_USER=sagara_backup
POSTGRES_BACKUP_PASSWORD=local-backup-password

BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=28
BACKUP_HOST_DIR=../backups
BACKUP_METRICS_HOST_DIR=../backups/metrics

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password
