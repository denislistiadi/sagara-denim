# Salin nilai yang dibutuhkan ke frontend/.env.local dan backend/.env.

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Biarkan kosong agar request /api melewati rewrite Next.js sehingga cookie
# autentikasi tetap same-origin. Isi hanya jika ingin memanggil FastAPI langsung.
NEXT_PUBLIC_API_URL=

# Hanya dibaca server Next.js untuk tujuan rewrite /api/:path*.
API_PROXY_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (salin juga ke backend/.env)
# ---------------------------------------------------------------------------
# PostgreSQL lokal (port default)
DATABASE_URL=postgresql+asyncpg://sagara:sagara@localhost:5432/sagara_denim
TEST_DATABASE_URL=postgresql+asyncpg://sagara:sagara@localhost:5432/sagara_denim_test

# Jika memakai Docker Compose, database terekspos di localhost:5433.
# DATABASE_URL=postgresql+asyncpg://sagara:sagara@localhost:5433/sagara_denim

# Ganti dengan nilai acak minimal 32 karakter sebelum produksi.
JWT_SECRET=ganti-secret-ini-sebelum-produksi-minimal-32-karakter
