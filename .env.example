# Salin nilai yang dibutuhkan ke frontend/.env.local
# Frontend hanya membaca variabel berawalan NEXT_PUBLIC_.

# URL API FastAPI (belum aktif pada tahap design system)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend FastAPI + PostgreSQL (rencana)
# Contoh: postgresql+psycopg://sagara:sagara@localhost:5432/sagara_denim
DATABASE_URL=postgresql+psycopg://sagara:sagara@localhost:5432/sagara_denim
