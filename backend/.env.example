# Aplikasi
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://sagara:sagara@localhost:5432/sagara_denim
TEST_DATABASE_URL=postgresql+asyncpg://sagara:sagara@localhost:5432/sagara_denim_test

# Autentikasi
# Ganti dengan nilai acak minimal 32 karakter sebelum produksi.
JWT_SECRET=ganti-secret-ini-sebelum-produksi-minimal-32-karakter
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000"]

# Seed pengguna demo
SEED_ADMIN_EMAIL=admin@sagara.co.id
SEED_ADMIN_PASSWORD=Admin#2026
SEED_OPERATOR_EMAIL=operator@sagara.co.id
SEED_OPERATOR_PASSWORD=Operator#2026
SEED_QC_EMAIL=qc@sagara.co.id
SEED_QC_PASSWORD=QC#2026
